# demo.sh grava o .env real a partir das saídas da stack. Este arquivo é só referência.
REGIAO=us-east-1
MODELO_CONVERSA=us.openai.gpt-5.6-luna
MODELO_EMBEDDING=cohere.embed-v4:0
DIMENSAO_EMBEDDING=1024
DADOS_BUCKET=pulso-dados-123456789012-us-east-1
DADOS_CHAVE=bases/bases.json
VETORES_BUCKET=pulso-vetores-123456789012
VETORES_INDICE=conhecimento
MEMORIA_ID=pulso_memoria-abc123
GUARDRAIL_ID=abc123def456
GUARDRAIL_VERSAO=1
PROMPT_ID=ABC123DEF4
# PROMPT_VERSAO=1   (descomente para fixar uma versão; sem isso, vale a última publicada)
GATEWAY_URL=https://pulso-gateway-abc123.gateway.bedrock-agentcore.us-east-1.amazonaws.com/mcp
RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:123456789012:runtime/pulso_agente-abc123
